{% from "issuer_masthead.html.j2" import issuer_masthead %}
{% macro refs(ids, labels, urls, color=none) -%}
{% set ref_color = color|default(link_color|default('#183f51', true), true) %}
{% if ids %}{% for source_id in ids %}<sup class="source-ref" style="font-size:11px;line-height:1;color:{{ ref_color }};margin-left:3px;vertical-align:super;"><a href="{{ urls.get(source_id, '#source-' ~ source_id) }}" style="color:{{ ref_color }};text-decoration:none;">[{{ labels.get(source_id, source_id) }}]</a></sup>{% endfor %}{% endif %}
{%- endmacro %}
{% macro cited(text, ids, labels, urls, color=none) -%}
{%- if ids -%}
{%- set words = text.rsplit(' ', 1) -%}
{% if words|length > 1 %}{{ words[0] }} {% endif %}<span class="citation-tail" style="white-space:nowrap;">{{ words[-1] }}{{ refs(ids, labels, urls, color) }}</span>
{%- else -%}{{ text }}{%- endif -%}
{%- endmacro %}
{% set _companies = companies|default([], true) %}
{% set _base_company = _companies[0] if _companies else {} %}
{% set _base_brand = _base_company.brand|default({}, true) %}
{% set _base_theme = _base_brand.theme|default({}, true) %}
{% set page_bg = _base_theme.page_bg|default('#f1f0ec', true) %}
{% set paper_bg = _base_theme.paper_bg|default('#fcfbf8', true) %}
{% set section_bg = _base_theme.section_bg|default('#f5f4f0', true) %}
{% set body_color = _base_theme.body_color|default(_base_theme.heading_color|default('#132129', true), true) %}
{% set secondary_color = _base_theme.secondary_color|default('#5d6972', true) %}
{% set link_color = _base_theme.link_color|default('#183f51', true) %}
{% set rule_color = _base_theme.rule_color|default('#dce3e6', true) %}
{% set hero_bg = _base_theme.hero_bg|default('#172d3a', true) %}
{% set hero_text = _base_theme.hero_text|default('#ffffff', true) %}
{% set hero_accent = _base_theme.hero_accent|default(_base_brand.primary_color|default('#183f51', true), true) %}
{% set positive_bg = _base_theme.positive_bg|default('#eaf2ed', true) %}
{% set positive_color = _base_theme.positive_color|default('#28513a', true) %}
{% set negative_bg = _base_theme.negative_bg|default('#faeceb', true) %}
{% set negative_color = _base_theme.negative_color|default('#8b3f37', true) %}
{% set prior_bar_color = _base_theme.prior_bar_color|default('#b7c7ce', true) %}
{% set current_bar_color = _base_theme.current_bar_color|default(_base_theme.link_color|default('#183f51', true), true) %}
{% set zero_color = _base_theme.zero_color|default(_base_theme.rule_color|default('#dce3e6', true), true) %}
{% set logo_bg = _base_theme.logo_bg|default('#ffffff', true) %}
{% if full_document %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ document_title }}</title>
{% endif %}
<style>
  html, body {
    margin: 0;
    padding: 0;
    background-color: {{ page_bg }};
    background: {{ page_bg }};
    color: {{ body_color }};
    font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
    -webkit-text-size-adjust: 100%;
  }
  .email-shell {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    background-color: {{ paper_bg }};
    background: {{ paper_bg }};
  }
  .email-wrap {
    padding: 16px;
  }
  .masthead {
    margin: 0 0 16px;
    padding: 0;
    border: 0;
  }
  .masthead-title {
    margin: 0;
    font-size: 11px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.2px;
  }
  .masthead-date {
    margin: 4px 0 0;
    color: {{ secondary_color }};
    font-size: 12px;
    line-height: 1.35;
  }
  .ticker-index {
    margin: 10px 0 0;
    color: {{ link_color }};
    font-size: 12px;
    line-height: 1.35;
  }
  .ticker-index a {
    color: {{ link_color }};
    text-decoration: none;
  }
  .company-section {
    margin: 0;
  }
  .company-section + .company-section {
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid {{ rule_color }};
  }
  .company-eyebrow {
    margin: 0 0 4px;
    color: {{ link_color }};
    font-size: 13px;
    line-height: 1.35;
    font-weight: 600;
  }
  .company-meta {
    margin: 0 0 12px;
    color: {{ secondary_color }};
    font-size: 12px;
    line-height: 1.35;
  }
  .company-headline {
    margin: 0 0 10px;
    color: {{ body_color }};
    font-size: 28px;
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.45px;
  }
  .company-deck {
    margin: 0;
    color: {{ hero_text }};
    font-size: 16px;
    line-height: 1.5;
    font-weight: 400;
  }
  .finding-band {
    margin: 16px 0 22px;
    padding: 16px;
    border-top: 3px solid {{ hero_accent }};
    background-color: {{ hero_bg }};
    background: {{ hero_bg }};
    color: {{ hero_text }};
  }
  .finding-band .company-headline {
    color: {{ hero_text }};
  }
  .earnings-chart {
    margin: 18px 0 0;
    padding: 16px;
    background-color: {{ section_bg }};
    background: {{ section_bg }};
  }
  .chart-title {
    margin: 0;
    color: {{ body_color }};
    font-size: 16px;
    line-height: 1.3;
    font-weight: 600;
  }
  .chart-scope {
    margin: 4px 0 0;
    color: {{ secondary_color }};
    font-size: 12px;
    line-height: 1.4;
  }
  .chart-plot {
    width: 100%;
    max-width: 380px;
    margin: 14px auto 0;
    table-layout: fixed;
    border-collapse: collapse;
    font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
  }
  .chart-value {
    margin: 0 0 5px;
    color: {{ body_color }};
    font-size: 22px;
    line-height: 1.15;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .chart-bar-table {
    width: 54px;
    max-width: 54px;
    margin: 0 auto;
    table-layout: fixed;
    border-collapse: collapse;
  }
  .chart-bar {
    width: 54px;
    max-width: 54px;
    padding: 0;
    line-height: 0;
  }
  .chart-zero {
    height: 1px;
    padding: 0;
    background-color: {{ zero_color }};
    background: {{ zero_color }};
    line-height: 0;
  }
  .chart-axis {
    margin: 7px 0 0;
    color: {{ secondary_color }};
    font-size: 12px;
    line-height: 1.3;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .chart-footer {
    margin: 10px 0 0;
    color: {{ secondary_color }};
    font-size: 12px;
    line-height: 1.35;
  }
  .section-title {
    margin: 28px 0 12px;
    color: {{ body_color }};
    font-size: 18px;
    line-height: 1.35;
    font-weight: 600;
  }
  .group-title {
    margin: 18px 0 5px;
    color: {{ body_color }};
    font-size: 14px;
    line-height: 1.35;
    font-weight: 600;
  }
  .group-scope {
    margin: 0 0 7px;
    color: {{ secondary_color }};
    font-size: 12px;
    line-height: 1.4;
  }
  .financial-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    color: {{ body_color }};
    background-color: {{ section_bg }};
    background: {{ section_bg }};
    font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.35;
  }
  .financial-table col.metric-col {
    width: 52%;
  }
  .financial-table col.value-col {
    width: 24%;
  }
  .financial-table th {
    padding: 8px 6px 9px;
    border-bottom: 1px solid {{ rule_color }};
    color: {{ secondary_color }};
    font-size: 12px;
    line-height: 1.25;
    font-weight: 600;
    text-align: right;
    vertical-align: bottom;
  }
  .financial-table th:first-child {
    padding-left: 8px;
    text-align: left;
  }
  .financial-table th:last-child {
    padding-right: 8px;
  }
  .financial-table td {
    padding: 13px 6px;
    border-bottom: 1px solid {{ rule_color }};
    vertical-align: middle;
  }
  .financial-table td.metric-label {
    padding-left: 8px;
    font-size: 13px;
    color: {{ body_color }};
    text-align: left;
  }
  .financial-table td.previous-value {
    color: {{ secondary_color }};
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .financial-table td.current-value {
    padding-right: 8px;
    color: {{ body_color }};
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .insight {
    margin: 16px 0 0;
    color: {{ body_color }};
    font-size: 16px;
    line-height: 1.5;
    font-weight: 400;
  }
  .insight strong {
    font-weight: 600;
  }
  .prose-title {
    margin: 28px 0 8px;
    color: {{ body_color }};
    font-size: 18px;
    line-height: 1.35;
    font-weight: 600;
  }
  .call-title {
    margin: 20px 0 8px;
    color: {{ body_color }};
    font-size: 14px;
    line-height: 1.35;
    font-weight: 600;
  }
  .prose {
    margin: 0;
    color: {{ body_color }};
    font-size: 16px;
    line-height: 1.55;
    font-weight: 400;
  }
  .question-title {
    margin: 28px 0 8px;
    color: {{ body_color }};
    font-size: 18px;
    line-height: 1.35;
    font-weight: 600;
  }
  .question {
    margin: 0;
    color: {{ body_color }};
    font-size: 16px;
    line-height: 1.5;
  }
  .sources-title {
    margin: 28px 0 10px;
    padding-top: 16px;
    border-top: 1px solid {{ rule_color }};
    color: {{ body_color }};
    font-size: 18px;
    line-height: 1.35;
    font-weight: 600;
  }
  .document-footer {
    margin: 28px 0 0;
    padding-top: 12px;
    border-top: 1px solid {{ rule_color }};
    color: {{ secondary_color }};
    font-size: 12px;
    line-height: 1.5;
  }
  @media only screen and (min-width: 701px) {
    .email-wrap {
      padding: 28px !important;
    }
    .company-headline:not(.coverage-headline) {
      font-size: 28px !important;
    }
    .finding-band {
      padding: 24px !important;
    }
    .earnings-chart {
      padding: 12px !important;
    }
  }
  @media only screen and (max-width: 390px) {
    .email-wrap {
      padding: 12px !important;
    }
    .company-headline:not(.coverage-headline) {
      font-size: 24px !important;
    }
    .earnings-chart {
      padding: 10px !important;
    }
    .financial-table {
      font-size: 13px !important;
      table-layout: fixed !important;
    }
    .financial-table th,
    .financial-table td {
      padding-top: 8px !important;
      padding-bottom: 8px !important;
      padding-left: 3px !important;
      padding-right: 3px !important;
    }
    .financial-table th:first-child,
    .financial-table td.metric-label {
      padding-left: 3px !important;
    }
    .financial-table th:last-child,
    .financial-table td.current-value {
      padding-right: 3px !important;
    }
    .financial-table th {
      font-size: 13px !important;
      white-space: normal !important;
      overflow-wrap: anywhere !important;
    }
    .financial-table td.previous-value,
    .financial-table td.current-value {
      font-size: 13px !important;
    }
    .financial-table .metric-col {
      width: 48% !important;
    }
    .financial-table .value-col {
      width: 26% !important;
    }
    .chart-plot {
      width: 100% !important;
      max-width: 100% !important;
    }
  }
</style>
{% if full_document %}</head>
<body data-brand-surface="page" style="margin:0;padding:0;background-color:{{ page_bg }};background:{{ page_bg }};color:{{ body_color }};font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
{% endif %}
<div class="email-shell" data-brand-surface="paper" style="width:100%;max-width:720px;margin:0 auto;background-color:{{ paper_bg }};background:{{ paper_bg }};color:{{ body_color }};font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
  <div class="email-wrap" data-brand-surface="paper" style="padding:16px;background-color:{{ paper_bg }};background:{{ paper_bg }};color:{{ body_color }};font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
    <header class="masthead" data-brand-surface="paper" style="margin:0 0 16px;padding:0;border:0;background-color:{{ paper_bg }};background:{{ paper_bg }};color:{{ body_color }};font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
      <p class="masthead-title" style="margin:0;color:{{ body_color }};font-size:11px;line-height:1.25;font-weight:600;letter-spacing:.1px;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">The Servicing Brief</p>
      {% if combined %}
      <nav class="ticker-index" aria-label="Company index" style="margin:8px 0 0;color:{{ link_color }};font-size:12px;line-height:1.35;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
        {% for company in companies %}<a href="#company-{{ company.ticker }}" style="display:inline-block;margin-right:30px;color:{{ link_color }};text-decoration:none;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ "%02d"|format(company.index) }}/{{ company.ticker }}</a>{% endfor %}
      </nav>
      {% endif %}
    </header>

    {% for company in companies %}
    {% set identity = company.company_identity|default({}) %}
    {% set identity_ticker = identity.ticker|default(company.ticker, true) %}
    {% set theme = company.brand.theme|default({}, true) %}
    {% set hero_bg = theme.hero_bg|default(company.brand.primary_color|default('#172d3a', true), true) %}
    {% set hero_text = theme.hero_text|default('#ffffff', true) %}
    {% set page_bg = theme.page_bg|default('#f1f0ec', true) %}
    {% set paper_bg = theme.paper_bg|default('#fcfbf8', true) %}
    {% set section_bg = theme.section_bg|default('#f5f4f0', true) %}
    {% set body_color = theme.body_color|default(theme.heading_color|default('#132129', true), true) %}
    {% set secondary_color = theme.secondary_color|default('#5d6972', true) %}
    {% set link_color = theme.link_color|default('#183f51', true) %}
    {% set rule_color = theme.rule_color|default('#dce3e6', true) %}
    {% set hero_accent = theme.hero_accent|default(company.brand.accent_color|default('#183f51', true), true) %}
    {% set positive_bg = theme.positive_bg|default('#eaf2ed', true) %}
    {% set positive_color = theme.positive_color|default('#28513a', true) %}
    {% set negative_bg = theme.negative_bg|default('#faeceb', true) %}
    {% set negative_color = theme.negative_color|default('#8b3f37', true) %}
    {% set prior_bar_color = theme.prior_bar_color|default('#b7c7ce', true) %}
    {% set current_bar_color = theme.current_bar_color|default(theme.link_color|default('#183f51', true), true) %}
    {% set zero_color = theme.zero_color|default(theme.rule_color|default('#dce3e6', true), true) %}
    {% set logo_bg = theme.logo_bg|default('#ffffff', true) %}
    <section id="company-{{ company.ticker }}" class="company-section" data-brand-surface="paper" data-ticker="{{ company.ticker }}" data-brief-kind="{{ company.brief_kind }}" data-brief-company="{{ identity_ticker }}" data-brief-cik="{{ identity.cik|default('', true) }}" data-brief-event="{{ identity.event|default(company.period, true) }}" style="{% if not loop.first %}margin-top:48px;padding-top:48px;border-top:1px solid {{ rule_color }};{% else %}margin:0;{% endif %}background-color:{{ paper_bg }};background:{{ paper_bg }};font-family:'Segoe UI',Arial,Helvetica,sans-serif;color:{{ body_color }};">
      {{ issuer_masthead(identity_ticker, company.name, company.period, company.event_label, company.call_date, company.brand) }}
      {% if company.brief_kind == 'coverage_note' %}<p class="coverage-label" style="margin:0 0 8px;color:{{ secondary_color }};font-size:13px;font-weight:600;">Coverage note</p>{% endif %}
      <section class="finding-band" data-brand-surface="hero" aria-labelledby="finding-{{ company.ticker }}" style="margin:16px 0 20px;padding:16px;border-top:3px solid {{ hero_accent }};background-color:{{ hero_bg }};background:{{ hero_bg }};color:{{ hero_text }};font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
        <h2 id="finding-{{ company.ticker }}" class="company-headline{% if company.brief_kind == 'coverage_note' %} coverage-headline{% endif %}" style="margin:0 0 10px;color:{{ hero_text }};font-size:{% if company.brief_kind == 'coverage_note' %}22px{% else %}24px{% endif %};line-height:1.15;font-weight:650;letter-spacing:-0.3px;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ company.headline }}</h2>
        {% if company.deck %}<p class="company-deck" style="margin:0;color:{{ hero_text }};font-size:16px;line-height:1.5;font-weight:400;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ cited(company.deck, company.deck_source_ids, company.ref_labels, company.ref_urls, hero_text) }}</p>{% endif %}
      </section>

      {% if company.call.findings|default([], true) %}
      <h3 class="call-title" style="margin:20px 0 8px;color:{{ body_color }};font-size:14px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{% if company.ticker == 'RY' %}From prepared remarks{% else %}From the earnings call{% endif %}</h3>
      {% for finding in company.call.findings %}
      {% if finding.label %}<p class="call-label" style="margin:0 0 4px;color:{{ secondary_color }};font-size:12px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ finding.label }}</p>{% endif %}
      {% if finding.text %}<p class="prose call-text" style="margin:0 0 12px;color:{{ body_color }};font-size:16px;line-height:1.5;font-weight:400;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ cited(finding.text, finding.source_ids, company.ref_labels, company.ref_urls) }}</p>{% endif %}
      {% endfor %}
      {% elif company.call.text %}
      <h3 class="call-title" style="margin:20px 0 8px;color:{{ body_color }};font-size:14px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{% if company.ticker == 'RY' %}From prepared remarks{% else %}From the earnings call{% endif %}</h3>
      <p class="prose call-text" style="margin:0;color:{{ body_color }};font-size:16px;line-height:1.5;font-weight:400;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ cited(company.call.text, company.call.source_ids, company.ref_labels, company.ref_urls) }}</p>
      {% endif %}

      {% for insight in company.insights %}
      {% if insight.text %}<p class="insight" style="margin:12px 0 0;color:{{ body_color }};font-size:16px;line-height:1.5;font-weight:400;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{% if insight.label %}<strong style="font-weight:600;">{{ insight.label }}. </strong>{% endif %}{{ cited(insight.text, insight.source_ids, company.ref_labels, company.ref_urls) }}</p>{% endif %}
      {% endfor %}

      {% if company.servicing_context.text %}
      <h3 class="prose-title" style="margin:24px 0 8px;color:{{ body_color }};font-size:18px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">Servicing context</h3>
      <p class="prose" style="margin:0;color:{{ body_color }};font-size:16px;line-height:1.5;font-weight:400;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ cited(company.servicing_context.text, company.servicing_context.source_ids, company.ref_labels, company.ref_urls) }}</p>
      {% endif %}

      {% if company.chart %}
      <div class="earnings-chart" data-brand-surface="section" role="img" aria-label="{{ company.chart.aria_label }}" style="margin:14px 0 0;padding:10px;background-color:{{ section_bg }};background:{{ section_bg }};color:{{ body_color }};font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
        <p class="chart-title" style="margin:0;color:{{ body_color }};font-size:16px;line-height:1.3;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ company.chart.title }}{{ refs(company.chart.source_ids, company.ref_labels, company.ref_urls) }}</p>
        <p class="chart-scope" style="margin:4px 0 0;color:{{ secondary_color }};font-size:12px;line-height:1.4;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ company.chart.scope }}{% if company.chart.unit %} · {{ company.chart.unit }}{% endif %}</p>
        {% set source_extent = 52 if company.chart.signed else 104 %}
        {% set plot_height = 36 if company.chart.signed else 72 %}
        <table class="chart-plot" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;max-width:380px;margin:8px auto 0;table-layout:fixed;border-collapse:collapse;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
          <tr>
            {% for point in company.chart.points %}
            {% set bar_height = ((point.height|float / (source_extent|float)) * (plot_height|float))|round(0, 'floor')|int %}
            {% if point.height > 0 and bar_height < 1 %}{% set bar_height = 1 %}{% endif %}
            <td align="center" valign="top" style="width:{{ (100 / (company.chart.points|length))|round(2) }}%;padding:0 4px;text-align:center;vertical-align:top;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
              <p class="chart-value" style="margin:0 0 4px;color:{{ body_color }};font-size:22px;line-height:1.15;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ point.display }}</p>
              {% if company.chart.signed %}
              {% set signed_height = plot_height * 2 + 1 %}
              <table class="chart-bar-table" role="presentation" width="54" height="{{ signed_height }}" cellpadding="0" cellspacing="0" style="width:54px;max-width:54px;height:{{ signed_height }}px;margin:0 auto;table-layout:fixed;border-collapse:collapse;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
                <tr>
                  <td valign="bottom" height="{{ plot_height }}" style="height:{{ plot_height }}px;padding:0;vertical-align:bottom;line-height:0;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
                    {% if not point.negative and point.height > 0 %}<span class="chart-bar" aria-hidden="true" style="display:block;width:54px;max-width:54px;height:{{ bar_height }}px;background-color:{% if point.current %}{{ current_bar_color }}{% else %}{{ prior_bar_color }}{% endif %};background:{% if point.current %}{{ current_bar_color }}{% else %}{{ prior_bar_color }}{% endif %};line-height:0;">&nbsp;</span>{% endif %}
                  </td>
                </tr>
                <tr><td class="chart-zero" height="1" bgcolor="{{ zero_color }}" style="height:1px;padding:0;background-color:{{ zero_color }};background:{{ zero_color }};line-height:0;font-size:1px;">&nbsp;</td></tr>
                <tr>
                  <td valign="top" height="{{ plot_height }}" style="height:{{ plot_height }}px;padding:0;vertical-align:top;line-height:0;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
                    {% if point.negative and point.height > 0 %}<span class="chart-bar" aria-hidden="true" style="display:block;width:54px;max-width:54px;height:{{ bar_height }}px;background-color:{% if point.current %}{{ current_bar_color }}{% else %}{{ prior_bar_color }}{% endif %};background:{% if point.current %}{{ current_bar_color }}{% else %}{{ prior_bar_color }}{% endif %};line-height:0;">&nbsp;</span>{% endif %}
                  </td>
                </tr>
              </table>
              {% else %}
              <table class="chart-bar-table" role="presentation" width="54" height="{{ plot_height }}" cellpadding="0" cellspacing="0" style="width:54px;max-width:54px;height:{{ plot_height }}px;margin:0 auto;table-layout:fixed;border-collapse:collapse;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
                <tr>
                  <td valign="bottom" height="{{ plot_height }}" style="height:{{ plot_height }}px;padding:0;vertical-align:bottom;border-bottom:1px solid {{ zero_color }};line-height:0;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">
                    {% if point.height > 0 %}<span class="chart-bar" aria-hidden="true" style="display:block;width:54px;max-width:54px;height:{{ bar_height }}px;background-color:{% if point.current %}{{ current_bar_color }}{% else %}{{ prior_bar_color }}{% endif %};background:{% if point.current %}{{ current_bar_color }}{% else %}{{ prior_bar_color }}{% endif %};line-height:0;">&nbsp;</span>{% endif %}
                  </td>
                </tr>
              </table>
              {% endif %}
              <p class="chart-axis" style="margin:6px 0 0;color:{{ secondary_color }};font-size:12px;line-height:1.3;font-weight:400;font-variant-numeric:tabular-nums;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ point.axis_period }}</p>
            </td>
            {% endfor %}
          </tr>
        </table>
        <p class="chart-footer" style="margin:6px 0 0;color:{{ secondary_color }};font-size:12px;line-height:1.35;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">Zero baseline</p>
      </div>
      {% endif %}

      {% if company.metric_groups %}
      {% for group in company.metric_groups %}
      <p class="group-title" style="margin:18px 0 5px;color:{{ body_color }};font-size:14px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ group.title }}</p>
      {% if group.scope %}<p class="group-scope" style="margin:0 0 7px;color:{{ secondary_color }};font-size:12px;line-height:1.4;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ group.scope }}</p>{% endif %}
      <table class="financial-table" data-brand-surface="section" data-metric-group="{{ group.key }}" width="100%" cellspacing="0" cellpadding="0" bgcolor="{{ section_bg }}" style="width:100%;border-collapse:collapse;table-layout:fixed;background-color:{{ section_bg }};background:{{ section_bg }};color:{{ body_color }};font-family:'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;line-height:1.35;">
        <colgroup><col class="metric-col" style="width:52%;"><col class="value-col" style="width:24%;"><col class="value-col" style="width:24%;"></colgroup>
        <thead>
          <tr>
            <th scope="col" style="padding:8px 6px 9px 8px;border-bottom:1px solid {{ rule_color }};color:{{ secondary_color }};font-size:12px;line-height:1.25;font-weight:600;text-align:left;vertical-align:bottom;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">Metric</th>
            <th scope="col" style="padding:8px 6px 9px;border-bottom:1px solid {{ rule_color }};color:{{ secondary_color }};font-size:12px;line-height:1.25;font-weight:600;text-align:right;vertical-align:bottom;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ group.previous_label }}</th>
            <th scope="col" style="padding:8px 8px 9px 6px;border-bottom:1px solid {{ rule_color }};color:{{ secondary_color }};font-size:12px;line-height:1.25;font-weight:600;text-align:right;vertical-align:bottom;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ group.current_label }}</th>
          </tr>
        </thead>
        <tbody>
          {% for row in group.rows %}
          <tr data-metric-index="{{ row.metric_index }}">
            <td class="metric-label" style="padding:13px 6px 13px 8px;border-bottom:1px solid {{ rule_color }};text-align:left;vertical-align:middle;font-size:13px;color:{{ body_color }};">{{ row.label }}{{ refs(row.source_ids, company.ref_labels, company.ref_urls) }}{% if row.unit %}<span class="metric-unit" style="display:block;font-size:12px;line-height:1.2;color:{{ secondary_color }};margin-top:2px;">{{ row.unit }}</span>{% endif %}</td>
            <td class="previous-value" aria-label="{{ row.label }} {{ group.previous_label }}: {{ row.previous_display }}" style="padding:13px 6px;border-bottom:1px solid {{ rule_color }};color:{{ secondary_color }};text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;vertical-align:middle;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ row.previous_display }}</td>
            <td class="current-value" aria-label="{{ row.label }} {{ group.current_label }}: {{ row.current_display }}" style="padding:13px 8px 13px 6px;border-bottom:1px solid {{ rule_color }};color:{% if row.highlight == 'green' %}{{ positive_color }}{% elif row.highlight == 'red' %}{{ negative_color }}{% else %}{{ body_color }}{% endif %};text-align:right;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;vertical-align:middle;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ row.current_display }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endfor %}
      {% endif %}

      {% if company.implications|default([], true) %}
      <h3 class="prose-title" style="margin:24px 0 8px;color:{{ body_color }};font-size:14px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">Analyst view</h3>
      {% for implication in company.implications %}
      {% if implication.text %}<p class="prose implication-text" style="margin:0 0 12px;color:{{ body_color }};font-size:16px;line-height:1.5;font-weight:400;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{% if implication.label %}<strong style="font-weight:600;">{{ implication.label }}. </strong>{% endif %}{{ cited(implication.text, implication.source_ids, company.ref_labels, company.ref_urls) }}</p>{% endif %}
      {% endfor %}
      {% endif %}

      {% if company.question %}
      <h3 class="question-title" style="margin:28px 0 8px;color:{{ body_color }};font-size:18px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">Questions</h3>
      <p class="question" style="margin:0;color:{{ body_color }};font-size:16px;line-height:1.5;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ company.question }}</p>
      {% endif %}

      {% if company.ai_analysis %}
      <h3 style="margin:28px 0 16px;padding-top:18px;border-top:2px solid {{ rule_color }};color:{{ body_color }};font-size:20px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">AI Analysis</h3>
      {% for item in company.ai_analysis %}
      {% if item.label %}<h4 style="margin:20px 0 8px;color:{{ body_color }};font-size:17px;line-height:1.4;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ item.label }}</h4>{% endif %}
      <p style="margin:0 0 16px;color:{{ body_color }};font-size:16px;line-height:1.65;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ cited(item.text, item.source_ids, company.ref_labels, company.ref_urls, link_color) }}</p>
      {% endfor %}
      {% endif %}

      {% if company.sources %}
      <h3 class="sources-title" style="margin:28px 0 10px;padding-top:16px;border-top:1px solid {{ rule_color }};color:{{ body_color }};font-size:18px;line-height:1.35;font-weight:600;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">Sources</h3>
      {% if company.call.availability %}<p class="source-note" style="margin:0 0 8px;color:{{ secondary_color }};font-size:12px;line-height:1.4;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ company.call.availability }}{{ refs(company.call.availability_source_ids, company.ref_labels, company.ref_urls) }}</p>{% endif %}
      {% for source in company.sources %}
      <p class="source-row" style="margin:0 0 7px;color:{{ body_color }};font-size:13px;line-height:1.4;"><a id="source-{{ source.display_id }}" href="{{ source.url }}" style="color:{{ link_color }};text-decoration:underline;">[{{ source.ref }}] {{ source.short_label }}</a></p>
      {% endfor %}
      {% endif %}
    </section>
    {% endfor %}

    {% if attachment_note %}
    <p class="document-footer" style="margin:28px 0 0;padding-top:12px;border-top:1px solid {{ rule_color }};color:{{ secondary_color }};font-size:12px;line-height:1.5;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ attachment_note }}</p>
    {% endif %}
    {% if combined %}
    <p class="document-footer" style="margin:28px 0 0;padding-top:12px;border-top:1px solid {{ rule_color }};color:{{ secondary_color }};font-size:12px;line-height:1.5;font-family:'Segoe UI',Arial,Helvetica,sans-serif;">{{ universe_note }}</p>
    {% endif %}
  </div>
</div>
{% if full_document %}</body>
</html>
{% endif %}



